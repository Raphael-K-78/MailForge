# Fournisseur d'envoi (resend ou gmail)
MAIL_PROVIDER=resend

# Clé API Resend
RESEND_API_KEY=

# Domaine du mail
MAIL_DOMAINE=raphael-k-78.fr.eu.org

# Gmail API + OAuth 2.0 (utilisés si MAIL_PROVIDER=gmail)
# credentials.json = fichier client OAuth téléchargé depuis Google Cloud Console
# token.json = généré automatiquement au premier envoi (ne pas committer)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Logging
# Taille max du fichier de log
LOG_MAX_SIZE_MB=20
# Nombre max de fichier de log (-1 = pas de suppression)
LOG_BACKUP_COUNT=32

# dossier des templates
TEMPLATES_DIR=templates